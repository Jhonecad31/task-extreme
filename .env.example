# Dominio público, sin barra al final. Para producción: https://tareas.tudominio.com
APP_ORIGIN=http://localhost:3000
# Solo se usa para configurar el administrador inicial. La contraseña NO va aquí.
INITIAL_ADMIN_EMAIL=admin@tudominio.com
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/task-extreme.sqlite
SESSION_HOURS=12
# Docker: déjalo en production; para localhost sin HTTPS usa development.
NODE_ENV=development
# Para Caddy (producción)
DOMAIN=tareas.tudominio.com
TLS_EMAIL=admin@tudominio.com
